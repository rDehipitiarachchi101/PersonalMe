---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { title, date, summary, tools, featured, demoUrl, codeUrl } = Astro.props.project.data;
const when = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<article class:list={['card', { featured }]}>
  <div class="main">
    {featured && <p class="badge">★ Featured</p>}
    <h3>{title}</h3>
    <time datetime={date.toISOString().slice(0, 10)}>{when}</time>
    <p class="summary">{summary}</p>
    {(demoUrl || codeUrl) && (
      <p class="links">
        {demoUrl && <a href={demoUrl} target="_blank" rel="noopener">Live demo ↗</a>}
        {codeUrl && <a href={codeUrl} target="_blank" rel="noopener">Code ↗</a>}
      </p>
    )}
  </div>
  <aside class="tools" aria-label="Tools used">
    <h4>Built with</h4>
    <ul>
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </aside>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 1fr minmax(170px, 240px);
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 18px;
    background: rgb(255 249 238 / 0.92);
    color: #2b1d24;
    box-shadow: inset 0 0 0 1px rgb(120 80 60 / 0.25), 0 18px 40px rgb(40 20 20 / 0.25);
  }
  .card.featured {
    box-shadow: inset 0 0 0 2px #e9b96b, 0 0 32px rgb(255 214 140 / 0.35), 0 18px 40px rgb(40 20 20 / 0.3);
  }
  .badge {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a8641c;
  }
  h3 { margin: 0; font-size: clamp(1.4rem, 3vw, 1.9rem); }
  time { display: block; margin-top: 0.2rem; color: #7a5a5a; font-size: 0.95rem; }
  .summary { margin: 0.9rem 0 0; line-height: 1.6; }
  .links { margin: 1rem 0 0; display: flex; gap: 1rem; flex-wrap: wrap; }
  .links a { color: #3247a8; font-weight: 600; }

  .tools {
    padding: 1rem 1.1rem;
    border-radius: 12px;
    background: #efe2cb;
    align-self: start;
  }
  .tools h4 {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7a5a5a;
  }
  .tools ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tools li {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: #fff8ec;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .card { grid-template-columns: 1fr; }
  }
</style>
