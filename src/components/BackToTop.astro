---
// Fixed arrow back to the beach. Hidden while the beach is on screen,
// since it would do nothing there.
---

<a class="to-top" href="#top" aria-label="Back to top" data-hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M12 19 V5 M5 12 L12 5 L19 12"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</a>

<script>
  const button = document.querySelector<HTMLAnchorElement>('.to-top');
  const beach = document.getElementById('top');
  if (button && beach) {
    new IntersectionObserver(
      ([entry]) => {
        button.toggleAttribute('data-hidden', entry.isIntersecting);
      },
      { threshold: 0.15 },
    ).observe(beach);
  }
</script>

<style>
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 50;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff8ec;
    color: #2b1d24;
    box-shadow: 0 6px 20px rgb(20 10 20 / 0.45);
    transition:
      opacity 0.25s,
      transform 0.25s;
  }
  .to-top svg {
    width: 24px;
    height: 24px;
  }
  .to-top:hover {
    transform: translateY(-3px);
  }
  .to-top:focus-visible {
    outline: 3px solid #e9b96b;
    outline-offset: 3px;
  }
  .to-top[data-hidden] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transition: none;
    }
  }
</style>
